rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {

    // Deny all reads/writes by default
    match /{allPaths=**} {
      allow read, write: if false;
    }

    // Enforce multi-tenancy by isolating files based on businessId and driverId
    match /tenants/{businessId}/drivers/{driverId}/receipts/{fileName} {
      // - A user can only access files within their own business's tenant folder.
      // - Their auth token's businessId must match the {businessId} in the path.
      // - Their userId must match the {driverId} in the path.
      allow read, write: if request.auth != null &&
                           request.auth.token.businessId == businessId &&
                           request.auth.uid == driverId;
    }
  }
}