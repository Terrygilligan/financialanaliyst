rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {
    // Deny all reads/writes by default
    match /{allPaths=**} {
      allow read, write: if false;
    }

    // Allow users to read/write to their own business's folder
    // The businessId in the path must match the businessId in the user's custom claims
    match /tenants/{businessId}/receipts/{userId}/{fileName} {
      allow read, write: if request.auth != null && request.auth.uid == userId && request.auth.token.businessId == businessId;
    }
  }
}