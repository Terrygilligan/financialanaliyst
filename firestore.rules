rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Deny all reads/writes by default
    match /{document=**} {
      allow read, write: if false;
    }

    // Allow access to a business's receipts only if the user belongs to that business
    match /businesses/{businessId}/receipts/{receiptId} {
      // - A user can read/write to the receipts collection if their auth token's
      //   businessId custom claim matches the businessId in the path.
      // - This enforces a siloed data architecture where tenants can only
      //   access their own data.
      allow read, write: if request.auth.token.businessId == businessId;
    }
  }
}