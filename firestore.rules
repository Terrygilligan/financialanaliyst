rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function getRole() {
      return request.auth.token.role;
    }

    function isSuperAdmin() {
      return getRole() == 'super_admin';
    }

    function isAdmin() {
      return getRole() == 'admin';
    }

    match /batches/{userId} {
      allow read: if request.auth != null && (isSuperAdmin() || isAdmin() || request.auth.uid == userId);
      allow write: if request.auth != null && (isSuperAdmin() || isAdmin() || request.auth.uid == userId);
    }

    match /users/{userId} {
      allow read: if request.auth != null && (isSuperAdmin() || isAdmin() || request.auth.uid == userId);
      allow write: if request.auth != null && (
        isSuperAdmin() ||
        (isAdmin() && resource.data.role != 'super_admin') ||
        request.auth.uid == userId
      );
    }

    match /billing/{docId} {
      allow read, write: if request.auth != null && isSuperAdmin();
    }
  }
}
